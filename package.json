{
  "name": "scholarpath",
  "version": "1.0.0",
  "private": true,
  "description": "International Scholarship Discovery & University Planning Platform",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
