# Optional Supabase configuration (Connected Mode)
# Leave blank to run ScholarPath in Demo Mode with local browser persistence.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional base path for GitHub Pages subpath hosting (e.g. /scholarpath/)
# Leave as / for local development or custom domain deployment.
VITE_BASE_PATH=/

# Optional AI explanation proxy endpoint (Edge Function or backend proxy; never put secret API keys here)
VITE_AI_ENDPOINT=
